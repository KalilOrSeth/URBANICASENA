        private string DetectIdColumn(SqlConnection conn)
        {
            // Detect if Cliente table uses IdCliente or IdUsuario as primary id column
            using (var cmd = new SqlCommand("SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME='Cliente' AND COLUMN_NAME='IdCliente'", conn))
            {
                var r = cmd.ExecuteScalar();
                if (r != null && Convert.ToInt32(r) > 0) return "IdCliente";
            }
            using (var cmd = new SqlCommand("SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME='Cliente' AND COLUMN_NAME='IdUsuario'", conn))
            {
                var r = cmd.ExecuteScalar();
                if (r != null && Convert.ToInt32(r) > 0) return "IdUsuario";
            }
            // default fallback
            return "IdCliente";
        }

        // Public helper to be used by business layer when creating associated Usuario
        public bool ColumnExistsForChecks(string columnName)
        {
            using (SqlConnection oConexion = new SqlConnection(Conexion.cn))
            {
                oConexion.Open();
                using (var cmd = new SqlCommand("SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME='Cliente' AND COLUMN_NAME=@col", oConexion))
                {
                    cmd.Parameters.AddWithValue("@col", columnName);
                    var r = cmd.ExecuteScalar();
                    return r != null && Convert.ToInt32(r) > 0;
                }
            }
        }

        private bool ColumnExists(SqlConnection conn, string columnName)
        {
            using (var cmd = new SqlCommand("SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME='Cliente' AND COLUMN_NAME=@col", conn))
            {
                cmd.Parameters.AddWithValue("@col", columnName);
                var r = cmd.ExecuteScalar();
                return r != null && Convert.ToInt32(r) > 0;
            }
        }

        private bool TableExists(SqlConnection conn, string tableName)
        {
            using (var cmd = new SqlCommand("SELECT COUNT(*) FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME = @tname", conn))
            {
                cmd.Parameters.AddWithValue("@tname", tableName);
                var r = cmd.ExecuteScalar();
                return r != null && Convert.ToInt32(r) > 0;
            }
        }

        public List<Cliente> Listar()
        {
            var lista = new List<Cliente>();

            using (SqlConnection oConexion = new SqlConnection(Conexion.cn))
            {
                oConexion.Open();
                string idCol = DetectIdColumn(oConexion);

                bool hasReestablecer = ColumnExists(oConexion, "Reestablecer");
                bool hasActivo = ColumnExists(oConexion, "Activo");
                bool hasRol = ColumnExists(oConexion, "Rol");
                bool hasFechaRegistro = ColumnExists(oConexion, "FechaRegistro");

                string select = $"SELECT {idCol} AS IdCliente, Nombres, Apellidos, Correo, Clave" +
                                (hasReestablecer ? ", Reestablecer" : ", 0 AS Reestablecer") +
                                (hasActivo ? ", Activo" : ", 1 AS Activo") +
                                (hasRol ? ", Rol" : ", 'Cliente' AS Rol") +
                                (hasFechaRegistro ? ", FechaRegistro" : ", NULL AS FechaRegistro") +
                                " FROM Cliente";

                SqlCommand cmd = new SqlCommand(select, oConexion);
                cmd.CommandType = System.Data.CommandType.Text;

                using (SqlDataReader dr = cmd.ExecuteReader())
                {
                    int idxId = dr.GetOrdinal("IdCliente");
                    int idxNombres = dr.GetOrdinal("Nombres");
                    int idxApellidos = dr.GetOrdinal("Apellidos");
                    int idxCorreo = dr.GetOrdinal("Correo");
                    int idxClave = dr.GetOrdinal("Clave");
                    int idxReestablecer = dr.GetOrdinal("Reestablecer");
                    int idxActivo = dr.GetOrdinal("Activo");
                    int idxRol = dr.GetOrdinal("Rol");
                    int idxFechaRegistro = hasFechaRegistro ? dr.GetOrdinal("FechaRegistro") : -1;

                    while (dr.Read())
                    {
                        var cliente = new Cliente
                        {
                            IdCliente = !dr.IsDBNull(idxId) ? dr.GetInt32(idxId) : 0,
                            Nombres = !dr.IsDBNull(idxNombres) ? dr.GetString(idxNombres) : string.Empty,
                            Apellidos = !dr.IsDBNull(idxApellidos) ? dr.GetString(idxApellidos) : string.Empty,
                            Correo = !dr.IsDBNull(idxCorreo) ? dr.GetString(idxCorreo) : string.Empty,
                            Clave = !dr.IsDBNull(idxClave) ? dr.GetString(idxClave) : string.Empty,
                            Reestablecer = !dr.IsDBNull(idxReestablecer) && dr.GetBoolean(idxReestablecer),
                            Activo = !dr.IsDBNull(idxActivo) && dr.GetBoolean(idxActivo),
                            Rol = !dr.IsDBNull(idxRol) ? dr.GetString(idxRol) : "Cliente",
                            FechaRegistro = (idxFechaRegistro >= 0 && !dr.IsDBNull(idxFechaRegistro)) ? dr.GetDateTime(idxFechaRegistro) : DateTime.MinValue
                        };
                        lista.Add(cliente);
                    }
                }
            }
            return lista;
        }

