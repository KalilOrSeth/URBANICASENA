@{
    ViewBag.Title = "Pago Completado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container text-center py-5">
    <div class="card shadow-lg mx-auto" style="max-width: 600px;">
        <div class="card-body">
            <div class="mb-4">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
            </div>
            <h2 class="text-success mb-3">¡Pago Completado!</h2>
            <p class="lead">@TempData["Success"]</p>

            @if (TempData["IdTransaccion"] != null)
            {
                <div class="alert alert-info mt-4">
                    <h5>Detalles de la Transacción</h5>
                    <p><strong>ID de Transacción PayPal:</strong> @TempData["IdTransaccion"]</p>
                    <p class="mb-0">Tu compra ha sido registrada exitosamente.</p>
                </div>
            }

            <div class="mt-4">
                <a href="@Url.Action("MisCompras","Tienda")" class="btn btn-primary btn-lg">
                    <i class="bi bi-bag-check"></i> Ver Mis Compras
                </a>
                <a href="@Url.Action("Index","Tienda")" class="btn btn-outline-secondary btn-lg ms-2">
                    <i class="bi bi-shop"></i> Seguir Comprando
                </a>
            </div>
        </div>
    </div>
</div>