@using CapaNegocio
@using CapaEntidad
@{
    // Compute cart count: if logged client, prefer DB count; otherwise session count
    int carritoCount = 0;
    var clienteSession = Session["Cliente"] as Cliente;
    if (clienteSession != null)
    {
        try
        {
            carritoCount = new CN_Carrito().CantidadEnCarrito(clienteSession.IdCliente);
        }
        catch
        {
            carritoCount = (Session["Carrito"] as System.Collections.IList)?.Count ?? 0;
        }
    }
    else
    {
        carritoCount = (Session["Carrito"] as System.Collections.IList)?.Count ?? 0;
    }

    var role = (Session["Role"] as string) ?? string.Empty;
    var cliente = clienteSession;
    // Determine display name: prefer Cliente session, then NombreUsuario (admin), then NombreCliente fallback
    var nombreCliente = cliente != null ? (cliente.Nombres + " " + cliente.Apellidos) : (Session["NombreUsuario"] as string ?? Session["NombreCliente"] as string);
    var adminAppUrl = System.Configuration.ConfigurationManager.AppSettings["AdminAppUrl"] as string;
    var adminLink = !string.IsNullOrWhiteSpace(adminAppUrl) ? adminAppUrl.TrimEnd('/') + "/Home/Index" : Url.Action("Index", "Home", new { area = "" });
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Mi Tienda</title>

    @Styles.Render("~/Content/css")
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container px-4 px-lg-5">
            <a class="navbar-brand" href="@Url.Action("Index","Tienda")">Mi Tienda</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent" aria-controls="#navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Tienda")">Catálogo</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Carrito","Tienda")">Carrito</a></li>
                    @if (role == "Cliente")
                    {
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Checkout","Tienda")">Checkout</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("MisCompras","Tienda")">Mis Compras</a></li>
                    }
                </ul>

                <div class="d-flex align-items-center">
                    <a href="@Url.Action("Carrito","Tienda")" class="btn btn-outline-dark me-3">
                        <i class="bi-cart-fill me-1"></i>
                        Carrito
                        <span id="contadorCarrito" class="badge bg-dark text-white ms-1 rounded-pill">@carritoCount</span>
                    </a>

                    @* Show dropdown for logged-in clients or admins *@
                    @if (cliente != null || role.Equals("Admin", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="dropdown">
                            <button class="btn btn-outline-dark dropdown-toggle d-flex align-items-center" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-2 fs-5"></i>
                                <span class="fw-bold">@nombreCliente</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                @if (role.Equals("Admin", StringComparison.OrdinalIgnoreCase))
                                {
                                    <li><h6 class="dropdown-header text-muted">👤 Admin</h6></li>
                                    <li>
                                        <a class="dropdown-item" href="@adminLink" target="_blank">
                                            <i class="bi bi-speedometer2 me-2"></i> Panel Admin
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                }
                                else
                                {
                                    <li><h6 class="dropdown-header text-muted">👤 Cliente</h6></li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Perfil","Tienda")">
                                            <i class="bi bi-person-lines-fill me-2"></i> Mi Perfil
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("MisCompras","Tienda")">
                                            <i class="bi bi-bag-check me-2"></i> Mis Compras
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                }

                                <li>
                                    <form action="@Url.Action("CerrarSesion","Acceso")" method="post" class="px-3">
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                            <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary" href="@Url.Action("Index","Acceso")">Iniciar Sesión</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Banner de bienvenida -->
    @if (!string.IsNullOrWhiteSpace(nombreCliente))
    {
        <div class="alert alert-info text-center rounded-pill shadow-sm mb-3">
            <strong>👋 Hola, @nombreCliente</strong> ¡Bienvenido a Mi Tienda!
        </div>
    }

    <!-- Main content -->
    <main class="py-4">
        <div class="container px-4 px-lg-5">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="py-5 bg-dark mt-auto">
        <div class="container">
            <p class="m-0 text-center text-white">Copyright &copy; Mi Tienda 2025</p>
            <div class="text-center mt-2">
                <a href="#" class="text-white text-decoration-none me-3">Política de Privacidad</a>
                <a href="#" class="text-white text-decoration-none">Términos &amp; Condiciones</a>
            </div>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @RenderSection("scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- SweetAlert2 + toast helper -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        window.showToast = function(message, type) {
            if (!message) return;
            var icon = 'info';
            if (type === 'success') icon = 'success';
            if (type === 'error') icon = 'error';
            if (type === 'warning') icon = 'warning';

            // Swal toast
            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer)
                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                }
            });

            Toast.fire({
                icon: icon,
                title: message
            });
        };

        // helper to refresh cart count in header
        window.updateCartCount = function() {
            $.get('@Url.Action("CantidadEnCarrito","Tienda")', function(resp){
                if (resp && resp.cantidad !== undefined) {
                    $('#contadorCarrito').text(resp.cantidad);
                }
            });
        };
    </script>
</body>
</html>