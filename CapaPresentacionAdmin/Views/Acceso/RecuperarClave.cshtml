@{
    ViewBag.Title = "Reestablecer contraseña";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Reestablecer contraseña</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-success">@ViewBag.Mensaje</div>
}

@using (Html.BeginForm("Reestablecer", "Acceso", FormMethod.Post))
{
    <div class="form-group mt-2">
        <label for="correo">Correo electrónico</label>
        <input type="email" id="correo" name="correo" class="form-control" placeholder="ejemplo@correo.com" required />
    </div>

    <button type="submit" class="btn btn-primary mt-3">Enviar código</button>
}
