@model CapaEntidad.Cliente
@{
    ViewBag.Title = "Editar Estado Activo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Editar Activo</h2>
<div class="card p-3" style="max-width:520px;">
    <div class="mb-3">
        <label class="form-label">Cliente</label>
        <input class="form-control" readonly value="@Model.Nombres @Model.Apellidos" />
    </div>

    <div class="mb-3 form-check form-switch">        <input class="form-check-input" type="checkbox" id="chkActivo" @(Model.Activo ? "checked" : "") />        <label class="form-check-label" for="chkActivo">Activo</label>    </div>
    <div class="d-flex justify-content-between">        <a href="@Url.Action("Index","Cliente")" class="btn btn-secondary">Cancelar</a>        <button id="btnGuardar" class="btn btn-primary">Guardar</button>    </div></div>@section scripts{    <script>        $(function(){            $('#btnGuardar').on('click', function(){                var id = @Model.IdCliente;                var activo = $('#chkActivo').is(':checked');                $.post('@Url.Action("GuardarActivo","Cliente")', { idCliente: id, activo: activo }, function(resp){                    if(resp && resp.ok){                        Swal.fire('Guardado','Estado actualizado','success').then(()=> location.href='@Url.Action("Index","Cliente")');                    } else {                        Swal.fire('Error', resp.mensaje || 'No se pudo actualizar','error');                    }                }, 'json').fail(function(){ Swal.fire('Error','Error de comunicación','error'); });            });        });    </script>}
