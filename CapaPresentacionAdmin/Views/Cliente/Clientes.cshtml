@{
    ViewBag.Title = "Clientes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Clientes</h2>

<div class="card shadow-sm">
    <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
        <span><i class="fas fa-users me-2"></i><strong>Lista de Clientes</strong></span>
        <a href='@Url.Action("Index", "Usuarios")' class="btn btn-primary btn-sm">
            <i class="fas fa-user-shield me-1"></i> Ver Admins
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="tablaClientes" class="table table-striped table-bordered align-middle" style="width:100%">
                <thead class="table-light">
                    <tr>
                        <th style="display:none">IdCliente</th>
                        <th>Nombres</th>
                        <th>Apellidos</th>
                        <th>Correo</th>
                        <th>Rol</th>
                        <th>Activo</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section styles{
    <style>
        /* Header gradient and text */
        #tablaClientes thead th {
            background: linear-gradient(135deg, #17a2b8, #0d6efd);
            color: #fff;
            font-weight: 600;
            text-align: center;
        }

        /* Align search to the right and length to the left using DataTables DOM wrappers */
        .dataTables_wrapper .dataTables_filter {
            margin: 0;
        }

        .dataTables_wrapper .dataTables_filter input {
            width: 220px;
            display: inline-block;
            margin-left: 0.5rem;
        }

        /* Pagination simple styling */
        .dataTables_wrapper .dataTables_paginate .paginate_button {
            border: 1px solid #ddd;
            padding: 4px 8px;
            margin-left: 4px;
            border-radius: 4px;
            background: #fff;
            color: #333 !important;
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button.current {
            background: #0d6efd;
            color: #fff !important;
            border-color: #0d6efd;
        }

        /* Ensure info and pagination are on same row and pagination to the right */
        .dt-bottom-row { display: flex; justify-content: space-between; align-items: center; }

        /* Make action buttons consistent and compact */
        .btn-group .btn { padding: 0.35rem 0.5rem; }

        /* Small badge spacing */
        .badge { font-size: 0.85rem; padding: 0.4rem 0.6rem; }
    </style>
}

@section scripts{
    <script>
    $(document).ready(function () {
        var tablaClientes = $("#tablaClientes").DataTable({
            responsive: true,
            ordering: false,
            pagingType: 'simple_numbers',
            ajax: {
                url: "@Url.Action("Listar", "Cliente")",
                type: "GET",
                dataType: "json",
                dataSrc: "" // el controlador devuelve un array JSON
            },
            columns: [
                { data: "IdCliente", visible: false },
                { data: "Nombres" },
                { data: "Apellidos" },
                { data: "Correo" },
                { data: "Rol" },
                {
                    data: "Activo",
                    render: function(valor) {
                        return valor
                            ? '<span class="badge bg-success">Sí</span>'
                            : '<span class="badge bg-danger">No</span>';
                    }
                },
                {
                    defaultContent:
                        '<div class="btn-group" role="group">' +
                        '<button type="button" class="btn btn-sm btn-outline-primary btn-detalle" title="Ver"><i class="fas fa-eye"></i></button>' +
                        '<button type="button" class="btn btn-sm btn-outline-warning btn-editar ms-1" title="Editar"><i class="fas fa-user-lock"></i></button>' +
                        '<button type="button" class="btn btn-sm btn-outline-danger btn-eliminar ms-1" title="Eliminar"><i class="fas fa-trash"></i></button>' +
                        '</div>',
                    orderable: false,
                    searchable: false,
                    className: "text-center"
                }
            ],
            dom: '<"d-flex justify-content-between mb-2"<"dataTables_length"l><"dataTables_filter"f>>' +
                 'rt' +
                 '<"dt-bottom-row mt-2"<"dataTables_info"i><"dataTables_paginate"p>>',
            language: {
                url: "https://cdn.datatables.net/plug-ins/2.3.5/i18n/es-ES.json"
            }
        });

        // Delegated actions
        $('#tablaClientes tbody').on('click', '.btn-detalle', function () {
            var data = tablaClientes.row($(this).closest('tr')).data();
            window.location = '@Url.Action("Detalles", "Cliente")' + '/' + data.IdCliente;
        });

        $('#tablaClientes tbody').on('click', '.btn-editar', function () {
            var data = tablaClientes.row($(this).closest('tr')).data();
            window.location = '@Url.Action("EditarActivo", "Cliente")' + '/' + data.IdCliente;
        });

        $('#tablaClientes tbody').on('click', '.btn-eliminar', function () {
            var data = tablaClientes.row($(this).closest('tr')).data();
            if (!data) return;
            var id = data.IdCliente;
            if (!confirm('¿Eliminar cliente?')) return;
            $.post('@Url.Action("Eliminar", "Cliente")', { idCliente: id }, function (resp) {
                if (resp && resp.resultado) {
                    tablaClientes.ajax.reload();
                } else {
                    alert(resp && resp.mensaje ? resp.mensaje : 'Error');
                }
            });
        });

    });
    </script>
}
