@model IEnumerable<CapaEntidad.Cliente>

@{
    ViewBag.Title = "Clientes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Clientes</h2>

<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")">Dashboard</a></li>
    <li class="breadcrumb-item active">Clientes</li>
</ol>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <i class="fas fa-users me-1"></i> Lista de Clientes
    </div>

    <div class="card-body">
        <div class="row mb-2">
            <div class="col-12">
                <a href='@Url.Action("Usuarios","Home")' class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Volver
                </a>
            </div>
        </div>



        <table id="tablaClientes" class="table table-striped table-bordered table-hover w-100">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombres</th>
                    <th>Apellidos</th>
                    <th>Correo</th>
                    <th>Estado</th>
                    <th>Registro</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.IdCliente</td>
                            <td>@c.Nombres</td>
                            <td>@c.Apellidos</td>
                            <td>@c.Correo</td>
                            <td>
                                @if (c.Activo)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td>@c.FechaRegistro.ToString("dd/MM/yyyy")</td>
                            <td>
                                <button class="btn btn-danger btn-sm btn-eliminar" data-id="@c.IdCliente">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            No hay clientes registrados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section scripts{
    <script>
        $(function(){
            $('#tablaClientes').DataTable({
                responsive: true,
                language: { url: 'https://cdn.datatables.net/plug-ins/2.3.5/i18n/es-ES.json' }
            });

            $('#tablaClientes').on('click', '.btn-eliminar', function(){
                var id = $(this).data('id');
                if(confirm('¿Eliminar cliente?')){
                    $.post('@Url.Action("Eliminar","Cliente")', { idCliente: id }, function(res){
                        if(res.resultado){
                            location.reload();
                        } else {
                            alert('Error: ' + res.mensaje);
                        }
                    });
                }
            });
        });
    </script>
}
