@model CapaEntidad.Usuario

@{
    ViewBag.Title = "Editar Usuario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Editar Usuario</h2>

<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")">Dashboard</a></li>
    <li class="breadcrumb-item"><a href="@Url.Action("Index","Usuarios")">Usuarios</a></li>
    <li class="breadcrumb-item active">Editar</li>
</ol>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="card">
    <div class="card-header bg-warning text-dark">
        <i class="fas fa-edit me-1"></i> Editar Usuario
    </div>
    <div class="card-body">
        @using (Html.BeginForm("Editar", "Usuarios", FormMethod.Post))
        {
            @Html.HiddenFor(m => m.IdUsuario)

            <div class="form-group mb-3">
                <label for="Nombres">Nombres</label>
                @Html.TextBoxFor(m => m.Nombres, new { @class = "form-control" })
            </div>

            <div class="form-group mb-3">
                <label for="Apellidos">Apellidos</label>
                @Html.TextBoxFor(m => m.Apellidos, new { @class = "form-control" })
            </div>

            <div class="form-group mb-3">
                <label for="Correo">Correo</label>
                @Html.TextBoxFor(m => m.Correo, new { @class = "form-control" })
            </div>

            <div class="form-group mb-3">
                <label for="Rol">Rol</label>
                @Html.DropDownListFor(m => m.Rol,
                    new SelectList(new[] { "Cliente", "Admin" }, Model.Rol),
                    new { @class = "form-control" })
            </div>

            <div class="form-group form-check mb-3">
                @Html.CheckBoxFor(m => m.Activo, new { @class = "form-check-input" })
                <label class="form-check-label" for="Activo">Activo</label>
            </div>

            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            @Html.ActionLink("Volver al listado", "Index", null, new { @class = "btn btn-secondary ms-2" })
        }
    </div>
</div>
